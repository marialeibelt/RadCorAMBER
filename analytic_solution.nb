Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dsigmaDQ2", "[", "Q2_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Emu", "=", "100"}], ",", 
        RowBox[{"mp", "=", "0.938272088"}], ",", 
        RowBox[{"mmu", "=", "0.105658375"}], ",", "pmuvec", ",", "alpha", ",",
         "tau", ",", "s", ",", "R", ",", "eps", ",", 
        RowBox[{"mup", "=", "2.79284734"}], ",", "GE", ",", "GM", ",", 
        "dsigmadQ2"}], "}"}], ",", 
      RowBox[{
       RowBox[{"pmuvec", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"Emu", "^", "2"}], "-", 
          RowBox[{"mmu", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"alpha", "=", 
        RowBox[{"1", "/", "137.035999084"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tau", "=", 
        RowBox[{"Q2", "/", 
         RowBox[{"(", 
          RowBox[{"4", "*", 
           RowBox[{"mp", "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"s", "=", 
        RowBox[{
         RowBox[{"2", "*", "Emu", "*", "mp"}], "+", 
         RowBox[{"mp", "^", "2"}], "+", 
         RowBox[{"mmu", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"R", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"pmuvec", "^", "2"}], "-", 
           RowBox[{"tau", "*", 
            RowBox[{"(", 
             RowBox[{"s", "-", 
              RowBox[{"2", "*", 
               RowBox[{"mp", "^", "2"}], "*", 
               RowBox[{"(", 
                RowBox[{"1", "+", "tau"}], ")"}]}]}], ")"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"pmuvec", "^", "2"}], "*", 
           RowBox[{"(", 
            RowBox[{"1", "+", "tau"}], ")"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"eps", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Emu", "^", "2"}], "-", 
           RowBox[{"tau", "*", 
            RowBox[{"(", 
             RowBox[{"s", "-", 
              RowBox[{"mmu", "^", "2"}]}], ")"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"pmuvec", "^", "2"}], "-", 
           RowBox[{"tau", "*", 
            RowBox[{"(", 
             RowBox[{"s", "-", 
              RowBox[{"2", "*", 
               RowBox[{"mp", "^", "2"}], "*", 
               RowBox[{"(", 
                RowBox[{"1", "+", "tau"}], ")"}]}]}], ")"}]}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"GE", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Q2", "/", "0.71"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"-", "2"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"GM", "=", 
        RowBox[{"mup", "*", "GE"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dsigmadQ2", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", "*", "Pi", "*", 
           RowBox[{
            RowBox[{"alpha", "^", "2"}], "/", 
            RowBox[{"Q2", "^", "2"}]}]}], ")"}], "*", "R", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"eps", "*", 
            RowBox[{"GE", "^", "2"}]}], "+", 
           RowBox[{"tau", "*", 
            RowBox[{"GM", "^", "2"}]}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dsigmadQ2", "*", "0.389379365"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ltarget", "=", "160"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hpres", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Npvol", "=", 
   RowBox[{"2.687", "*", 
    RowBox[{"10", "^", "19"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ibeam", "=", 
   RowBox[{"2", "*", 
    RowBox[{"10", "^", "6"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Np", "=", 
   RowBox[{"Npvol", "*", "2", "*", 
    RowBox[{"(", 
     RowBox[{"Hpres", "/", "1.013"}], ")"}], "*", "ltarget"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigmaSmall", "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"dsigmaDQ2", "[", "Q2", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"Q2", ",", "0.0005", ",", "0.001"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigmaBig", "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"dsigmaDQ2", "[", "Q2", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"Q2", ",", "0.001", ",", "0.04"}], "}"}]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"in", " ", "mb"}], "*)"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigmaFull", " ", "=", " ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"dsigmaDQ2", "[", "Q2", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"Q2", ",", "0.0005", ",", "0.04"}], "}"}]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"in", " ", "mb"}], "*)"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rateBig", "=", 
   RowBox[{"sigmaBig", "*", 
    RowBox[{"10", "^", 
     RowBox[{"-", "27"}]}], "*", "Np", "*", "Ibeam"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rateSmall", "=", 
   RowBox[{"sigmaSmall", "*", 
    RowBox[{"10", "^", 
     RowBox[{"-", "27"}]}], "*", "Np", "*", "Ibeam"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rateFull", "=", 
    RowBox[{"sigmaFull", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "27"}]}], "*", "Np", "*", "Ibeam"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Sigma small:\>\"", ",", "sigmaSmall"}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Sigma big:\>\"", ",", "sigmaBig"}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Sigma full:\>\"", ",", "sigmaFull"}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Rate small:\>\"", ",", "rateSmall"}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Rate big:\>\"", ",", "rateBig"}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Rate full:\>\"", ",", "rateFull"}], "]"}]}], "Input",
