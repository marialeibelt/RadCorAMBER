#!/bin/bash

set -euo pipefail


# ============================================================
# FILE LOCATIONS
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CONFIG="${SCRIPT_DIR}/../inputs/input_coral_phast.conf"
JOBFILE="${SCRIPT_DIR}/coral_phast.job"


# ============================================================
# READ CONFIG
# ============================================================

if [ ! -f "$CONFIG" ]; then
    echo "ERROR: Config file not found:"
    echo "  $CONFIG"
    exit 1
fi

source "$CONFIG"

: "${INPUTDIR:?INPUTDIR not defined in config}"
: "${FILE_GLOB:?FILE_GLOB not defined in config}"
: "${CORALPHAST_RUNS:?CORALPHAST_RUNS not defined in config}"
: "${OUTPUTDIR:?OUTPUTDIR not defined in config}"
: "${MDSTDIR:?MDSTDIR not defined in config}"
: "${TRAFDICDIR:?TRAFDICDIR not defined in config}"
: "${HISTDIR:?HISTDIR not defined in config}"
: "${CORALDIR:?CORALDIR not defined in config}"
: "${PHASTDIR:?PHASTDIR not defined in config}"
: "${CORALOPTORIGINAL:?CORALOPTORIGINAL not defined in config}"
: "${SIMULATIONDIR:?SIMULATIONDIR not defined in config}"
: "${DETECTORSDAT:?DETECTORSDAT not defined in config}"
: "${DICOFIT:?DICOFIT not defined in config}"
: "${DETECTORSROOT:?DETECTORSROOT not defined in config}"
: "${USEREVENT:?USEREVENT not defined in config}"
: "${MAX_JOBS:?MAX_JOBS not defined in config}"
: "${QUEUE:?QUEUE not defined in config}"
: "${MEMORY:?MEMORY not defined in config}"

if [ ! -f "$JOBFILE" ]; then
    echo "ERROR: Job file not found:"
    echo "  $JOBFILE"
    exit 1
fi

if [ ! -d "$INPUTDIR" ]; then
    echo "ERROR: Input directory does not exist:"
    echo "  $INPUTDIR"
    exit 1
fi

if ! [[ "$MAX_JOBS" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: MAX_JOBS must be a positive integer."
    echo "Current value: $MAX_JOBS"
    exit 1
fi


# ============================================================
# COUNT TGEANT FILES
# ============================================================

mapfile -t INPUTFILES < <(
    find "$INPUTDIR" -maxdepth 1 -type f -name "$FILE_GLOB" -print | sort -V
)

NFILES="${#INPUTFILES[@]}"

if [ "$NFILES" -eq 0 ]; then
    echo "ERROR: No matching TGEANT files found."
    echo "Directory: $INPUTDIR"
    echo "Pattern:   $FILE_GLOB"
    exit 1
fi

TC="$MAX_JOBS"
if [ "$TC" -gt "$NFILES" ]; then
    TC="$NFILES"
fi


# ============================================================
# CREATE OUTPUT / SNAPSHOT DIRECTORIES
# ============================================================

mkdir -p "$MDSTDIR" "$TRAFDICDIR" "$HISTDIR"

SNAPSHOT_DIR="${CORALPHAST_RUNS}/submission_configs"
mkdir -p "$SNAPSHOT_DIR"

STAMP="$(date +%Y%m%d_%H%M%S)"
CONFIG_SNAPSHOT="${SNAPSHOT_DIR}/input_coral_phast_${STAMP}_$$.conf"

cp "$CONFIG" "$CONFIG_SNAPSHOT"


# ============================================================
# SUBMISSION SUMMARY
# ============================================================

echo "============================================================"
echo "Submit CORAL + PHAST"
echo "============================================================"
echo "Input directory:   $INPUTDIR"
echo "File pattern:      $FILE_GLOB"
echo "TGEANT files:      $NFILES"
echo "Array tasks:       1-$NFILES"
echo "Max simultaneous:  $TC"
echo "Queue/class:       $QUEUE"
echo "Memory per task:   $MEMORY"
echo "mDST output:       $MDSTDIR"
echo "CORAL hist output: $TRAFDICDIR"
echo "PHAST output:      $HISTDIR"
echo "Config snapshot:   $CONFIG_SNAPSHOT"
echo "============================================================"


# ============================================================
# SUBMIT
# ============================================================

qsub \
    -N coral_phast \
    -S /bin/bash \
    -wd "$CORALPHAST_RUNS" \
    -j y \
    -o /dev/null \
    -t "1-${NFILES}" \
    -tc "$TC" \
    -l "${QUEUE}=TRUE,h_pmem=${MEMORY}" \
    -v "CONFIG_SNAPSHOT=${CONFIG_SNAPSHOT}" \
    "$JOBFILE"
